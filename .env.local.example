NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key-hier-eintragen

# ── KI-Provider ────────────────────────────────────────────────
# "local"   → Ollama (kein API-Key nötig, gratis)
# "mistral" → Mistral Cloud (MISTRAL_API_KEY erforderlich)
AI_PROVIDER=local

# Ollama-Konfiguration (nur relevant wenn AI_PROVIDER=local)
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434/api

# Mistral Cloud (nur relevant wenn AI_PROVIDER=mistral)
# MISTRAL_API_KEY=dein-mistral-key-hier
